# Cloud fallback: prepare verified local wheels using the documented host command.
FROM python:3.12-slim
WORKDIR /app
COPY build/wheels /wheels
COPY pyproject.toml requirements.lock.txt ./
COPY src ./src
RUN pip install --no-cache-dir --no-index --find-links=/wheels -c requirements.lock.txt . \
    && rm -rf /wheels
COPY alembic.ini ./
COPY alembic ./alembic
COPY data ./data
COPY scripts/__init__.py ./scripts/__init__.py
COPY scripts/responses_emulator ./scripts/responses_emulator
COPY scripts/local_model.py ./scripts/local_model.py
COPY scripts/local_evaluation.py ./scripts/local_evaluation.py
RUN mkdir -p local_data
CMD ["python", "-m", "jobintel.runtime", "--host", "0.0.0.0"]
