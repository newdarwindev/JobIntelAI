# Cloud fallback: prepare verified local wheels using the documented host command.
FROM python:3.12-slim
WORKDIR /app
COPY build/wheels /wheels
COPY pyproject.toml requirements.lock.txt ./
COPY src ./src
RUN pip install --no-cache-dir --no-index --find-links=/wheels -c requirements.lock.txt . \
    && rm -rf /wheels
COPY alembic.ini ./
COPY alembic ./alembic
COPY data ./data
RUN mkdir -p local_data
CMD ["python", "-m", "jobintel.runtime", "--host", "0.0.0.0"]
