# Local synthetic demonstration only. Never commit actual credentials.
JOBINTEL_DATABASE_URL=sqlite:///./local_data/jobintel.db
JOBINTEL_PROVIDER=fixture
# Fixture replay is the offline default. Live execution requires explicit authorization.
# JOBINTEL_CONFIGURATION=fixture_normalized
# For authorized live extraction, select all three runtime settings:
# JOBINTEL_PROVIDER=openai
# JOBINTEL_OPENAI_MODEL=<explicit structured-output-compatible model>
# OPENAI_API_KEY=<supply through a secret manager or secure exported environment>
# JOBINTEL_CONFIGURATION=openai_normalized_v1
# JOBINTEL_OPENAI_TIMEOUT=30
# The app also supports a mounted secret instead of OPENAI_API_KEY:
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# Export these settings for scripts/runtime.py; it does not load this file:
# JOBINTEL_OPENAI_KEY_FILE=/absolute/path/to/private/openai-key
# JOBINTEL_POSTGRES_PASSWORD=local-demo-only
# JOBINTEL_COMPOSE_DATABASE_URL=postgresql+psycopg://jobintel:local-demo-only@db/jobintel
# JOBINTEL_CA_BUNDLE=/absolute/path/to/combined-ca-bundle.pem

# Explicit CPU provider (Compose local-inference selects its pinned endpoint):
# JOBINTEL_PROVIDER=local
# JOBINTEL_CONFIGURATION=local_normalized_v1
# JOBINTEL_LOCAL_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
# JOBINTEL_LOCAL_TIMEOUT=120
# JOBINTEL_LOCAL_MODEL_CACHE=/absolute/path/to/verified-model-cache
