{
  "name": "jobintel-web-ui-workflows",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ui": "node scripts/run_ui.mjs",
    "test:ui:headed": "node scripts/run_ui.mjs --headed --project=desktop-chromium",
    "record:ui": "node scripts/publish_mutation_evidence.mjs && node scripts/publish_batch_evidence.mjs && node scripts/publish_ui_recordings.mjs",
    "check:ui": "node scripts/check_ui_contract.mjs",
    "test:recordings": "node tests/unit/ui_recordings.test.mjs",
    "test:drafts": "node --test tests/unit/editor_drafts.test.mjs",
    "test:mutations": "node --test tests/unit/mutation_client.test.mjs",
    "test:batches": "node --test tests/unit/batches.test.mjs tests/unit/ui_artifact_parts.test.mjs",
    "prepare:ui-artifacts": "node scripts/prepare_ui_artifacts.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
