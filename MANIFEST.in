include LICENSE README.md alembic.ini requirements.lock.txt
include Dockerfile Dockerfile.offline Dockerfile.acquisition docker-compose*.yml .env.example
recursive-include data *.json *.csv *.txt
recursive-include alembic *.py *.mako
recursive-include scripts *.py *.sh
recursive-include tests *.py *.json
prune local_data
prune work
prune results/generated
prune docs/ui-recordings
global-exclude __pycache__ *.py[cod] *.db .env *.pem *.key
