FROM python:3.12-slim
WORKDIR /app
ENV PYTHONPATH=/app/src
COPY src/jobintel/__init__.py src/jobintel/egress_policy.py src/jobintel/egress_proxy.py src/jobintel/fetch_destinations.py src/jobintel/fetch_types.py src/jobintel/url_identity.py src/jobintel/
COPY scripts/__init__.py scripts/__init__.py
COPY scripts/acquisition_fixtures scripts/acquisition_fixtures
COPY data/sample_jobs/SYN-01.txt data/sample_jobs/SYN-01.txt
